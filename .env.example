# App
NODE_ENV=development
PORT=3000
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=100
UPLOAD_MAX_FILE_SIZE_BYTES=10485760
UPLOAD_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,application/pdf

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/file_service"

# AWS
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
AWS_REGION=us-east-1

# Presigned URL expiration in seconds
PRESIGNED_URL_EXPIRES_IN=300
